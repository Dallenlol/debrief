---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows: [string, string, string, string, string][] = [
  ["Price", "Free, MIT open source", "Free tier and paid plans", "Free tier and paid plans", "Free tier and paid plans"],
  ["Where recordings and transcripts are stored", "Your computer", "The provider's cloud", "The provider's cloud", "The provider's cloud"],
  ["Works offline", "Yes", "No", "No", "No"],
  ["Account required", "No", "Yes", "Yes", "Yes"],
  ["Where transcription runs", "On your computer (whisper.cpp)", "Cloud", "Cloud", "Cloud"],
  ["Where AI summaries and chat run", "On your computer, or a cloud AI you choose with your own key", "Cloud", "Cloud", "Cloud"],
  ["Source code", "Open (MIT)", "Closed", "Closed", "Closed"],
  ["Bring your own model", "Yes (Ollama, LM Studio, any OpenAI-compatible server, or your own Claude/OpenAI/OpenRouter key)", "No", "No", "No"],
];
---

<Base title="Debrief vs Fathom, Otter and Fireflies" description="How Debrief, the open-source offline meeting recorder, compares with Fathom, Otter.ai and Fireflies.ai on privacy, price, offline use, transcription and AI summaries.">
  <section style="padding: 56px 0 24px;">
    <p class="eyebrow">Comparison</p>
    <h1>Debrief vs Fathom, Otter and Fireflies</h1>
    <p class="muted" style="max-width: 680px; font-size: 18px;">The cloud recorders are good products. They work by storing your recordings and transcripts on their servers. Debrief is for people who want those features with everything kept on their own computer.</p>
  </section>

  <table>
    <thead><tr><th></th><th>Debrief</th><th>Fathom</th><th>Otter.ai</th><th>Fireflies.ai</th></tr></thead>
    <tbody>
      {rows.map(([k, a, b, c, d]) => <tr><td><b>{k}</b></td><td class="yes">{a}</td><td class="muted">{b}</td><td class="muted">{c}</td><td class="muted">{d}</td></tr>)}
    </tbody>
  </table>
  <p class="muted" style="font-size: 13px; margin-top: 10px;">Competitor details summarised from their public pages as of September 2026. Fathom, Otter.ai and Fireflies.ai are trademarks of their respective owners; Debrief is not affiliated with or endorsed by them. Corrections welcome on <a href={`${SITE.repo}/issues`}>GitHub</a>.</p>

  <section style="margin-top: 56px; max-width: 720px;">
    <h2>When Debrief is the wrong choice</h2>
    <p class="muted">If you need a bot to record meetings you don't attend, a mobile app, or transcripts shared to a whole company automatically, a cloud service is a better fit today. Debrief is for the meetings you're in, on the computer you're using.</p>
    <h2 style="margin-top: 40px;">When Debrief is the right choice</h2>
    <p class="muted">Client calls under NDA. Medical, legal and HR conversations. Anyone who has read a meeting-bot privacy policy all the way to the end. Anyone who wants the recorder to still work in five years without a subscription.</p>
    <a class="btn ember" href={`${base}/download/`} style="margin-top: 8px;">Download Debrief</a>
  </section>
</Base>
